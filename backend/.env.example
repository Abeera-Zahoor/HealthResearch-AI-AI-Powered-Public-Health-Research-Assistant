# =====================================================================
# HealthResearch AI - backend settings
# Copy this file to ".env" (start.bat does that for you on first run)
# and edit the copy. NEVER commit ".env" to GitHub (.gitignore already
# blocks it). Keys go ONLY in this backend file, never in the frontend.
# =====================================================================

# ---------------------------------------------------------------------
# 1) LLM provider (the "writing brain" of the agents)
# ---------------------------------------------------------------------
# PubMed and Europe PMC need NO key. Only the LLM needs one.
#
# LLM_PROVIDER choices:
#   none       - no LLM. The app still retrieves real papers and runs every
#                agent in a basic "extractive" mode (text taken straight from
#                abstracts, no generated prose). Free, good for a first test.
#   openai     - any OpenAI-compatible chat API (OpenAI, Groq, OpenRouter,
#                Google Gemini's OpenAI-compatible endpoint, local Ollama...)
#   anthropic  - Anthropic Claude API
LLM_PROVIDER=none

# Your secret key for the provider above (leave empty for "none").
# For a local Ollama server any placeholder text works (e.g. ollama).
LLM_API_KEY=

# Model name. If empty, defaults are used:
#   openai -> gpt-4o-mini      anthropic -> claude-haiku-5-5
# Always check your provider's current model list - names change.
LLM_MODEL=

# Only for provider "openai". Leave empty to use OpenAI itself.
# Examples (verify in your provider's docs):
#   Groq:        https://api.groq.com/openai/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Gemini:      https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama:      http://localhost:11434/v1
LLM_BASE_URL=

# Optional tuning
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=3500

# ---------------------------------------------------------------------
# 2) Literature APIs (both free; keys are OPTIONAL)
# ---------------------------------------------------------------------
# A free NCBI key raises the PubMed rate limit from 3 to 10 requests/second.
# Get one at https://www.ncbi.nlm.nih.gov/account/ (Settings > API Key).
NCBI_API_KEY=
# NCBI asks you to identify yourself with an email address (optional).
NCBI_EMAIL=

# Include preprints (not peer reviewed) from Europe PMC? Default: false.
INCLUDE_PREPRINTS=false

# ---------------------------------------------------------------------
# 3) App settings (normally leave as is)
# ---------------------------------------------------------------------
DEFAULT_MAX_PAPERS=10
HTTP_TIMEOUT_SECONDS=25
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATABASE_PATH=C:\path\to\healthresearch.db

# Advanced: override the literature API addresses (only needed for testing
# against a local mock server). Leave commented out for normal use.
# PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
# EUROPEPMC_BASE_URL=https://www.ebi.ac.uk/europepmc/webservices/rest
